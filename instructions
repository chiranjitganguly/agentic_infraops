/speckit-specify
title: Agentic InfraOps Self-Service Platform (Phase 1)

goal:
Build an agentic Infrastructure Operations (InfraOps) self-service system on GCP that supports:
- Infrastructure provisioning
- Infrastructure status enquiry
- Best-practice guidance (FAQ)

scope:
in_scope:
- VM provisioning (Compute Engine)
- Storage bucket provisioning (Cloud Storage)
- Basic VPC setup
- Resource status queries
- Documentation-based FAQ responses
out_of_scope:
- Incident detection
- Alerting
- Root cause analysis
- Cost optimization
- Policy enforcement

users:

* platform_engineers
* developers

interaction_channels:

* email
* chatbot

core_capabilities:

* intent_classification (provision, enquiry, faq)
* request_normalization (unstructured → structured)
* workflow_orchestration
* event_driven_communication
* knowledge_retrieval

architecture_constraints:
agent_framework: Google ADK
workflow_engine: Apache Airflow
service_catalog: Backstage
communication:
- a2a
- pubsub
cloud_provider: GCP
open_source_preference: true
mcp_usage: required_where_possible

agents_required:

* orchestrator_agent:
  role: central coordinator and router
* provisioning_agent:
  role: infra provisioning on GCP
* enquiry_agent:
  role: infra status retrieval
* faq_agent:
  role: best practices and documentation answers

key_flows:

* name: provision_vm
  steps:

  * user_request_via_chat_or_email
  * normalize_request
  * classify_intent_provision
  * orchestrator_routes_to_provisioning
  * airflow_executes_provisioning
  * publish_status_event

* name: enquiry_flow
  steps:

  * user_requests_status
  * normalize_request
  * classify_intent_enquiry
  * orchestrator_routes_to_enquiry_agent
  * fetch_status_from_gcp
  * return_response

* name: faq_flow
  steps:

  * user_asks_question
  * normalize_request
  * classify_intent_faq
  * orchestrator_routes_to_faq_agent
  * retrieve_documents
  * generate_answer

non_functional_requirements:
observability:
- logging
- metrics
- tracing
security:
- authentication (OAuth2 or equivalent)
- authorization (RBAC)
- audit_logs
reliability:
- idempotent_requests
- retry_mechanisms
scalability:
- stateless_agents
- horizontal_scaling

extensibility_requirements:

* ability_to_add_new_agents
* pluggable_workflows
* extensible_message_contracts

expected_output_from_speckit:

* agent_definitions
* communication_contracts
* pubsub_topic_definitions
* airflow_dag_specs
* input_output_schemas
* gcp_integration_specs
* knowledge_retrieval_design

intent_examples:
  provision:
    - "Create a VM with 4 CPUs in us-central1"
  enquiry:
    - "What is the status of vm-123?"
  faq:
    - "What is the best practice for VPC design?"



