# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=infraops
POSTGRES_PASSWORD=changeme
POSTGRES_DB=infraops

# ─── GCP ─────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_SA_KEY_PATH=./secrets/gcp-sa.json

# ─── LiteLLM Gateway ─────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-changeme-litellm-master
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── Model selection per agent (must match a model_name in litellm_config.yaml) ──
# Available: gpt-4o-2024-11-20 | gpt-4o-mini-2024-07-18 | claude-sonnet-4-6 | claude-haiku-4-6
INTENT_CLASSIFICATION_MODEL=gpt-4o-2024-11-20
FAQ_GENERATION_MODEL=claude-sonnet-4-6
# Embedding model — must match a model_name in litellm_config.yaml
EMBEDDING_MODEL=text-embedding-3-small

# ─── Airflow ─────────────────────────────────────────────────────────────────
AIRFLOW_FERNET_KEY=changeme-base64-fernet-key-32-chars
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_PASSWORD=changeme

# ─── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=changeme

# ─── Backstage ───────────────────────────────────────────────────────────────
BACKSTAGE_API_URL=http://localhost:7007/api
BACKSTAGE_API_TOKEN=changeme-backstage-token

# ─── Gmail / Email Channel ────────────────────────────────────────────────────
INFRAOPS_EMAIL=infraops@example.com
GMAIL_CREDENTIALS_PATH=./secrets/gmail-credentials.json
# gmail-token volume is auto-managed by the gmail container

# ─── Web Backend ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ─── PubSub Emulator (local dev only — unset in production) ──────────────────
PUBSUB_EMULATOR_HOST=localhost:8085

# ─── Developer Guardrails (comma-separated) ───────────────────────────────────
ALLOWED_REGIONS=us-central1,us-east1,europe-west1
ALLOWED_MACHINE_TYPES=e2-standard-2,e2-standard-4,e2-standard-8
ALLOWED_STORAGE_CLASSES=STANDARD,NEARLINE
DEVELOPER_DAILY_LIMIT=10
